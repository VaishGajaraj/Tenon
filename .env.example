# Copy to .env.local (Next.js) — scripts also read .env.local via tsx dotenv preload in scripts.
# Leave DATABASE_URL unset to use embedded PGlite at ./.tenon-data (zero-setup dev mode).
# DATABASE_URL=postgres://tenon:tenon@localhost:5432/tenon

# Leave ANTHROPIC_API_KEY unset to run in MOCK model mode (canned outputs, fully offline demo).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional OpenAI-compatible embeddings for hybrid retrieval (not required for the MOCK demo).
# TENON_EMBED_URL=https://api.openai.com/v1/embeddings
# TENON_EMBED_API_KEY=sk-...
# TENON_EMBED_MODEL=text-embedding-3-small

# Model used for first-pass drafting and self-check.
TENON_DRAFT_MODEL=claude-sonnet-4-5
# Frontier model used for reflection (learning loop) and eval grading.
TENON_REFLECT_MODEL=claude-opus-4-5
